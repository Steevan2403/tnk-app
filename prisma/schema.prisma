// SQLite for local development. The models use types Prisma supports on
// PostgreSQL as well: swap the provider and DATABASE_URL when moving off SQLite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  staff
}

enum ContractorStatus {
  pending
  approved
}

enum ResidentType {
  owner
  tenant
  other
}

enum Occupancy {
  owner_occupied
  investment
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  name               String
  passwordHash       String
  role               UserRole
  selectedBuildingId String?
  selectedBuilding   Building?        @relation(fields: [selectedBuildingId], references: [id], onDelete: SetNull)
  contractorNotes    ContractorNote[]
  apartmentNotes     ApartmentNote[]
  casesCreated       Case[]
  caseFiles          CaseFile[]
  caseComments       CaseComment[]
  caseActivities     CaseActivity[]
  caseStars          CaseStar[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Building {
  id         String   @id @default(cuid())
  name       String
  address    String
  suburb     String
  state      String
  postcode   String
  photoUrl   String?
  lotCount   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  selectedBy User[]
  apartments Apartment[]
  assets     Asset[]
  cases      Case[]
}

// Contractors belong to the account, not to one building.
model ContractorCategory {
  id        String              @id @default(cuid())
  name      String              @unique
  companies ContractorCompany[]
  createdAt DateTime            @default(now())
}

model ContractorCompany {
  id         String               @id @default(cuid())
  name       String
  abn        String?
  address    String?
  phone      String?
  email      String?
  website    String?
  status     ContractorStatus     @default(approved)
  categoryId String
  category   ContractorCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contacts   ContractorContact[]
  notes      ContractorNote[]
  documents  ContractorDocument[]
  insurances ContractorInsurance[]
  assets     Asset[]
  caseLinks  CaseCompany[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ContractorContact {
  id        String            @id @default(cuid())
  companyId String
  company   ContractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  phone     String?
  mobile    String?
  email     String?
  assets    Asset[]
  caseLinks CaseContact[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([companyId])
}

model ContractorNote {
  id        String            @id @default(cuid())
  companyId String
  company   ContractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  body      String
  authorId  String
  author    User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime          @default(now())

  @@index([companyId])
}

model ContractorDocument {
  id         String            @id @default(cuid())
  companyId  String
  company    ContractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  uploadedAt DateTime          @default(now())

  @@index([companyId])
}

model ContractorInsurance {
  id                    String            @id @default(cuid())
  companyId             String
  company               ContractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type                  String
  policyNumber          String?
  insurer               String?
  expiresOn             DateTime
  certificateName       String?
  certificateStoredName String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([companyId])
  @@index([expiresOn])
}

// Apartments and the people, vehicles, and files on them belong to one building.
model Apartment {
  id          String            @id @default(cuid())
  buildingId  String
  building    Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  number      String
  lotNumber   String
  occupancy   Occupancy         @default(owner_occupied)
  residents   Resident[]
  vehicles    Vehicle[]
  documents   ApartmentDocument[]
  images      ApartmentImage[]
  notes       ApartmentNote[]
  owners      ApartmentOwner[]
  agent       ManagingAgent?
  cases       Case[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([buildingId, number])
  @@unique([buildingId, lotNumber])
  @@index([buildingId])
}

model Resident {
  id             String       @id @default(cuid())
  apartmentId    String
  apartment      Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  type           ResidentType
  phone          String?
  mobile         String?
  secondaryPhone String?
  email          String?
  moveInOn       DateTime?
  moveOutOn      DateTime?
  primaryContact Boolean      @default(false)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([apartmentId])
  @@index([type])
}

model Vehicle {
  id              String    @id @default(cuid())
  apartmentId     String
  apartment       Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  registration    String
  make            String?
  model           String?
  colour          String?
  carSpace        String?
  location        String?
  photoName       String?
  photoStoredName String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([apartmentId])
}

model ApartmentDocument {
  id         String    @id @default(cuid())
  apartmentId String
  apartment  Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  expiresOn  DateTime?
  uploadedAt DateTime  @default(now())

  @@index([apartmentId])
}

model ApartmentImage {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name        String
  storedName  String
  uploadedAt  DateTime  @default(now())

  @@index([apartmentId])
}

model ApartmentNote {
  id          String    @id @default(cuid())
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  body        String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([apartmentId])
}

model ApartmentOwner {
  id              String    @id @default(cuid())
  apartmentId     String
  apartment       Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  mobile          String?
  email           String?
  postalAddress   String?
  strataCommittee Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([apartmentId])
}

model ManagingAgent {
  id          String    @id @default(cuid())
  apartmentId String    @unique
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  company     String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Asset categories belong to the account. Assets belong to one building.
model AssetCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Asset {
  id             String             @id @default(cuid())
  buildingId     String
  building       Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  categoryId     String
  category       AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  location       String?
  make           String?
  model          String?
  serialNumber   String?
  barcode        String?
  purchasedOn    DateTime
  assetValue     Decimal?
  endOfLifeValue Decimal?
  lifeMonths     Int?
  description    String?
  companyId      String?
  company        ContractorCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        ContractorContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  photos         AssetPhoto[]
  documents      AssetDocument[]
  warranties     AssetWarranty[]
  caseLinks      CaseAsset[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([buildingId])
  @@index([categoryId])
  @@index([companyId])
  @@index([contactId])
}

model AssetPhoto {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  uploadedAt DateTime @default(now())

  @@index([assetId])
}

model AssetDocument {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name       String
  storedName String
  uploadedAt DateTime @default(now())

  @@index([assetId])
}

model AssetWarranty {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider  String
  startsOn  DateTime
  expiresOn DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([expiresOn])
}

// Cases belong to one building. Work orders are a later feature: the model is
// here so a case can have many, lettered from the case number (12-A, 12-B).
enum CasePriority {
  urgent
  high
  medium
  low
}

enum CaseStatus {
  new
  in_progress
  awaiting_contractor
  awaiting_quote
  awaiting_invoice
  completed
  closed
}

enum CaseArea {
  asset
  apartment
  none
}

enum CaseFileKind {
  photo
  video
  quote
  invoice
  document
}

enum CaseActivityKind {
  created
  status_changed
  field_changed
  file_added
  comment_added
}

model CaseType {
  id        String   @id @default(cuid())
  name      String   @unique
  cases     Case[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Case {
  id                  String         @id @default(cuid())
  buildingId          String
  building            Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  number              Int
  typeId              String
  type                CaseType       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  purchaseOrderNumber String?
  startDate           DateTime
  dueDate             DateTime
  priority            CasePriority   @default(low)
  status              CaseStatus     @default(new)
  completedAt         DateTime?
  subject             String
  descriptionHtml     String         @default("")
  internalNotes       String?
  includeInReport     Boolean        @default(true)
  area                CaseArea       @default(none)
  apartmentId         String?
  apartment           Apartment?     @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  createdById         String
  createdBy           User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assets              CaseAsset[]
  companies           CaseCompany[]
  contacts            CaseContact[]
  files               CaseFile[]
  comments            CaseComment[]
  activities          CaseActivity[]
  stars               CaseStar[]
  workOrders          WorkOrder[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([buildingId, number])
  @@index([buildingId, status])
  @@index([buildingId, startDate])
  @@index([typeId])
  @@index([apartmentId])
  @@index([createdById])
  @@index([dueDate])
}

model CaseAsset {
  caseId  String
  case    Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([caseId, assetId])
  @@index([assetId])
}

model CaseCompany {
  caseId    String
  case      Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  companyId String
  company   ContractorCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([caseId, companyId])
  @@index([companyId])
}

model CaseContact {
  caseId    String
  case      Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  contactId String
  contact   ContractorContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([caseId, contactId])
  @@index([contactId])
}

model CaseFile {
  id           String       @id @default(cuid())
  caseId       String
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind         CaseFileKind
  name         String
  storedName   String
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt   DateTime     @default(now())

  @@index([caseId])
  @@index([uploadedById])
}

model CaseComment {
  id        String        @id @default(cuid())
  caseId    String
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    CaseComment?  @relation("CaseCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CaseComment[] @relation("CaseCommentReplies")
  body      String
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@index([caseId])
  @@index([parentId])
  @@index([authorId])
}

model CaseActivity {
  id        String           @id @default(cuid())
  caseId    String
  case      Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind      CaseActivityKind
  summary   String
  createdAt DateTime         @default(now())

  @@index([caseId])
  @@index([actorId])
}

model CaseStar {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, caseId])
  @@index([caseId])
}

model WorkOrder {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  suffix    String
  createdAt DateTime @default(now())

  @@unique([caseId, suffix])
}
