# Local development only. Copy to .env. Do not use these values anywhere else.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="local-development-secret-not-for-production"
AUTH_URL="http://localhost:3000"

# Mail stays in the local outbox. Set MAIL_TRANSPORT=smtp only when an SMTP
# server should be used, and do not commit credentials.
# MAIL_TRANSPORT=outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Optional secret for POST /api/cron/reminders. npm run reminders does not use it.
# CRON_SECRET=
